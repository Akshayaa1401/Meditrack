<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                              http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Meditrack - Smart Biomedical Waste Management and Collection System</display-name>

    <!--
        NOTE ON SERVLET/FILTER MAPPINGS:
        This project uses Servlet 4.0 annotations (@WebServlet, @WebFilter) declared
        directly on each class (see src/main/java/com/meditrack/servlet/*.java and
        com.meditrack.filter.AuthFilter). Tomcat 9 auto-discovers these at deploy
        time, so no <servlet>/<servlet-mapping> entries are required here. This is
        the modern, recommended approach (avoids keeping two sources of truth in
        sync) and is fully equivalent to classic XML-based mapping.

        Example of the annotation used in each servlet:
            @WebServlet("/login")
            public class LoginServlet extends HttpServlet { ... }

        If you prefer classic XML mappings instead of annotations, remove the
        @WebServlet annotation from the class and add the equivalent here:
            <servlet>
                <servlet-name>LoginServlet</servlet-name>
                <servlet-class>com.meditrack.servlet.LoginServlet</servlet-class>
            </servlet>
            <servlet-mapping>
                <servlet-name>LoginServlet</servlet-name>
                <url-pattern>/login</url-pattern>
            </servlet-mapping>
    -->

    <!-- Application-wide configuration, can be overridden by MONGO_URI / MONGO_DB env vars -->
    <context-param>
        <param-name>mongoConnectionString</param-name>
        <param-value>mongodb://localhost:27017</param-value>
    </context-param>
    <context-param>
        <param-name>mongoDatabaseName</param-name>
        <param-value>meditrack</param-value>
    </context-param>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout> <!-- minutes -->
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/WEB-INF/views/error500.jsp</location>
    </error-page>

    <!-- JSTL/EL config -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <el-ignored>false</el-ignored>
            <page-encoding>UTF-8</page-encoding>
            <scripting-invalid>false</scripting-invalid>
            <include-prelude>/WEB-INF/jspf/taglibs.jspf</include-prelude>
        </jsp-property-group>
    </jsp-config>

    <mime-mapping>
        <extension>json</extension>
        <mime-type>application/json</mime-type>
    </mime-mapping>

</web-app>
